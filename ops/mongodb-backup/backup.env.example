# Install this file ONLY on the database host 15.204.246.10:
#   /etc/asat/mongodb-backup.env
# chmod 600 /etc/asat/mongodb-backup.env
# NEVER commit the real file.
# Do NOT install the backup timer on the application host 15.204.211.185.
#
# After terraform apply in ASAT-V2-DEPLOYMENT-BACKEND, copy these from Parameter Store:
#   /asat/prod/mongodb-backup/aws.accessKeyId
#   /asat/prod/mongodb-backup/aws.secretAccessKey
#   /asat/prod/mongodb-backup/s3.bucket
#   /asat/prod/mongodb-backup/s3.kmsKeyId

# MongoDB on this host (dump over localhost — not through the app host)
MONGO_HOST=127.0.0.1
MONGO_PORT=28395
MONGO_AUTH_DB=admin
MONGO_PUBLIC_HOST=15.204.246.10

# Dedicated backup reader (not the application admin user).
# Use single quotes when a secret contains $ or spaces. Bash expands unquoted $.
MONGO_BACKUP_USER=asatBackup
MONGO_BACKUP_PASSWORD='CHANGE_ME'

# Credentials with write access for mongorestore (root / restore user).
# asatBackup is read-only and cannot restore.
# MONGO_ROOT_USER=admin
# MONGO_ROOT_PASSWORD='CHANGE_ME'
# MONGO_RESTORE_USER=admin
# MONGO_RESTORE_PASSWORD='CHANGE_ME'

# Amazon S3. Paste the four SecureString values from Parameter Store.
# Do not use the ECR deploy key. The script does not call SSM itself.
AWS_REGION=us-east-1
# /asat/prod/mongodb-backup/aws.accessKeyId
AWS_ACCESS_KEY_ID=AKIA_CHANGE_ME
# /asat/prod/mongodb-backup/aws.secretAccessKey
AWS_SECRET_ACCESS_KEY='CHANGE_ME'
# /asat/prod/mongodb-backup/s3.bucket
S3_BUCKET=asatv2-mongodb-backups-prod-636494949614
# /asat/prod/mongodb-backup/s3.kmsKeyId
S3_KMS_KEY_ID=arn:aws:kms:us-east-1:636494949614:key/KEY_ID

# Local scratch on the database host (not the MongoDB data directory)
LOCAL_WORKDIR=/var/lib/asat-mongodb-backup

# Fail if new archive < half of previous successful size (0.5)
SIZE_RATIO_MIN=0.5
